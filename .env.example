# Copy to .env and fill in. Never commit .env.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemma 4 model on the Gemini API: gemma-4-31b-it or gemma-4-26b-a4b-it
GEMMA_MODEL=gemma-4-31b-it
MAX_IMAGES_PER_PAPER=6
RENDER_DPI=110

# Only for docker compose with a named Cloudflare Tunnel (see deploy/cloudflare/README.md)
CLOUDFLARE_TUNNEL_TOKEN=
